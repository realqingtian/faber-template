# =============================== 应用配置 ===============================
# 运行模式，可选：development、testing、production
RUN_MODE=production
# 应用主机地址
APP_HOST=127.0.0.1
# 应用端口号
APP_PORT=8000
# 应用名称
APP_NAME=faber-template
# 应用描述
APP_DESCRIPTION="一个由 Beanie 和 MongoDB 提供支持的 FastAPI 服务模板"
# 应用版本
APP_VERSION=0.1.0
# 应用 Swagger API 文档 URL
APP_API_DOCS_URL=/docs
# 应用 ReDoc API 文档 URL
APP_API_REDOC_URL=/redoc
# 应用 OpenAPI API 文档 URL
APP_OPENAPI_URL=/openapi.json
# 是否启用应用调试模式
APP_DEBUG=true
# 是否启用应用重载
APP_RELOAD=true

# =============================== 跨域配置 ===============================
# 允许的跨域请求来源列表，多个用逗号分隔
CORS_ORIGINS_LIST="http://localhost:8000,http://localhost:3000,http://localhost:8080"

# =============================== MongoDB 配置 ===============================
# MongoDB 连接 URI；生产环境请通过安全方式注入账号和密码
MONGODB_URI=mongodb://localhost:27017?authSource=admin
# MongoDB 数据库名称
MONGODB_DATABASE=faber-template
# MongoDB 服务器选择超时时间（毫秒）
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# =============================== JWT 配置 ===============================
# JWT HMAC 签名密钥，必须替换为独立随机值；可通过 openssl rand -hex 32 生成
JWT_SECRET_KEY=8f99a5dca23f8b46cc5a54074eda04affac1fdc602f1a65c2d1f7bba35b1f1a1
# JWT 签名算法，当前固定支持 HS256
JWT_ALGORITHM=HS256
# JWT 访问令牌有效期（天），范围为 1-30
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30
# JWT 刷新令牌有效期（天），范围为 1-180
JWT_REFRESH_TOKEN_EXPIRE_DAYS=180

# =============================== 日志配置 ===============================
# 最低日志级别，可选：TRACE、DEBUG、INFO、SUCCESS、WARNING、ERROR、CRITICAL
LOG_LEVEL=DEBUG
# 是否将控制台和文件日志输出为 JSON 序列化结构
LOG_SERIALIZE=false
# 是否将日志输出到文件
LOG_OUTPUT_FILE=false
# 单个日志文件达到该条件时轮转
LOG_ROTATION="10 MB"
# 轮转日志超过该期限后自动清理
LOG_RETENTION="30 days"
# 访问日志文件名
ACCESS_LOG_FILE=access_%Y%m%d.log
# 错误日志文件名
ERROR_LOG_FILE=error_%Y%m%d.log
