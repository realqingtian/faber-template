# ========================= 应用基础配置 =========================
# 应用名称
APP_NAME=faber-template
# 应用描述
APP_DESCRIPTION="一个由 Beanie 和 MongoDB 提供支持的 FastAPI 服务模板"
# 应用版本
APP_VERSION=0.1.0
# 运行模式，例如：development、testing、production
APP_RUN_MODE=production
# Uvicorn 监听主机
APP_HOST=127.0.0.1
# Uvicorn 监听端口，范围为 1-65535
APP_PORT=8000
# 是否启用调试模式
APP_DEBUG=false
# Swagger UI 文档路径，访问地址为 http://127.0.0.1:8000/docs；如要关闭设置为 null
APP_API_DOCS=/docs
# ReDoc 文档路径，访问地址为 http://127.0.0.1:8000/redoc；如要关闭设置为 null
APP_API_REDOC=/redoc
# OpenAPI 文档路径，访问地址为 http://127.0.0.1:8000/openapi.json；如要关闭设置为 null
APP_API_OPENAPI=/openapi.json

# ========================= 日志配置 =========================
# 最低日志级别，可选：TRACE、DEBUG、INFO、SUCCESS、WARNING、ERROR、CRITICAL
LOG_LEVEL=INFO
# 普通日志文件路径，记录 TRACE 至 WARNING；相对路径固定从项目根目录解析
LOG_FILE_PATH=logs/app.log
# 错误日志文件路径，记录 ERROR 与 CRITICAL；相对路径固定从项目根目录解析
LOG_ERROR_FILE_PATH=logs/error.log
# 是否将控制台和文件日志输出为 JSON 序列化结构
LOG_SERIALIZE=false
# 是否通过队列异步写入，建议多线程或多进程服务保持开启
LOG_ENQUEUE=true
# 单个日志文件达到该条件时轮转；设置为 null 可关闭轮转
LOG_ROTATION="10 MB"
# 轮转日志超过该期限后自动清理；设置为 null 可永久保留
LOG_RETENTION="30 days"

# ========================= MongoDB 配置 =========================
# MongoDB 连接 URI；生产环境请通过安全方式注入账号和密码
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB 数据库名称
MONGODB_DATABASE=faber-template
# MongoDB 服务器选择超时时间（毫秒）
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ========================= JWT 配置 =========================
# JWT HMAC 签名密钥，必须替换为独立随机值；可通过 openssl rand -hex 32 生成
JWT_SECRET_KEY=8f99a5dca23f8b46cc5a54074eda04affac1fdc602f1a65c2d1f7bba35b1f1a1
# JWT 签名算法，当前固定支持 HS256
JWT_ALGORITHM=HS256
# JWT 访问令牌有效期（分钟），范围为 1-10080
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
